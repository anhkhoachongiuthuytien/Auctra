<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.controller.AuthController">
    <padding>
        <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
    </padding>

    <Label styleClass="screen-title" text="Auction System Login"/>
    <Label wrapText="true" maxWidth="520.0"
           text="Week 8 demo: login, validation, exception handling, unit testing, and JavaFX MVC-style controller/viewmodel separation."/>
    <TextField fx:id="emailField" maxWidth="320.0" promptText="Enter email"/>
    <Button mnemonicParsing="false" onAction="#handleLogin" prefWidth="160.0" text="Login"/>
    <Label fx:id="messageLabel" maxWidth="520.0" styleClass="info-label" wrapText="true"/>
</VBox>
