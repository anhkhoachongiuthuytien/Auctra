<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.controller.AuctionController">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <Label styleClass="screen-title" text="Auction List"/>
    <Label fx:id="welcomeLabel" wrapText="true"/>
    <Label fx:id="summaryLabel" styleClass="info-label" wrapText="true"/>
    <Label fx:id="actionMessageLabel" styleClass="info-label" wrapText="true"/>

    <TableView fx:id="auctionTable" prefHeight="420.0">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="220.0" text="Auction ID"/>
            <TableColumn fx:id="itemColumn" prefWidth="220.0" text="Item"/>
            <TableColumn fx:id="sellerColumn" prefWidth="180.0" text="Seller"/>
            <TableColumn fx:id="statusColumn" prefWidth="160.0" text="Status"/>
            <TableColumn fx:id="priceColumn" prefWidth="140.0" text="Current Price"/>
        </columns>
    </TableView>

    <HBox spacing="12.0">
        <TextField fx:id="bidAmountField" prefWidth="180.0" promptText="Bid amount"/>
        <Button fx:id="placeBidButton" mnemonicParsing="false" onAction="#handlePlaceBid" text="Place Bid"/>
        <Button fx:id="finishAuctionButton" mnemonicParsing="false" onAction="#handleFinishAuction" text="Finish Auction"/>
        <Button mnemonicParsing="false" onAction="#handleRefresh" text="Refresh"/>
        <Button mnemonicParsing="false" onAction="#handleBackToLogin" text="Back to Login"/>
    </HBox>
</VBox>
