<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.ForgotPasswordController">
    <VBox alignment="CENTER" spacing="24.0">
        <padding>
            <Insets top="48.0" right="36.0" bottom="48.0" left="36.0"/>
        </padding>

        <!-- Brand -->
        <HBox alignment="CENTER" spacing="12.0">
            <StackPane styleClass="app-logo">
                <Label styleClass="app-logo-text" text="AX"/>
            </StackPane>
            <VBox alignment="CENTER" spacing="2.0">
                <HBox alignment="CENTER" spacing="0">
                    <Label style="-fx-text-fill: #4285F4; -fx-font-size: 20; -fx-font-weight: bold;" text="A"/>
                    <Label style="-fx-text-fill: #EA4335; -fx-font-size: 20; -fx-font-weight: bold;" text="u"/>
                    <Label style="-fx-text-fill: #FBBC05; -fx-font-size: 20; -fx-font-weight: bold;" text="c"/>
                    <Label style="-fx-text-fill: #4285F4; -fx-font-size: 20; -fx-font-weight: bold;" text="t"/>
                    <Label style="-fx-text-fill: #34A853; -fx-font-size: 20; -fx-font-weight: bold;" text="r"/>
                    <Label style="-fx-text-fill: #EA4335; -fx-font-size: 20; -fx-font-weight: bold;" text="a"/>
                </HBox>
                <Label styleClass="app-subtitle" text="Đặt lại mật khẩu"/>
            </VBox>
        </HBox>

        <!-- Reset card -->
        <VBox alignment="TOP_CENTER" spacing="16.0" styleClass="card" maxWidth="420.0">
            <Label styleClass="screen-title" text="Quên mật khẩu?"/>
            <Label styleClass="muted-label" wrapText="true" maxWidth="360.0"
                   style="-fx-text-alignment: center;"
                   text="Nhập email và tên đăng nhập của tài khoản để xác thực, sau đó đặt mật khẩu mới."/>

            <VBox spacing="12.0" maxWidth="360.0">
                <Label styleClass="muted-label" style="-fx-font-size: 12;" text="Email"/>
                <TextField fx:id="emailField" promptText="you@example.com"/>

                <Label styleClass="muted-label" style="-fx-font-size: 12;" text="Tên đăng nhập"/>
                <TextField fx:id="usernameField" promptText="Tên đăng nhập của tài khoản"/>

                <Label styleClass="muted-label" style="-fx-font-size: 12;" text="Mật khẩu mới"/>
                <PasswordField fx:id="newPasswordField" promptText="Ít nhất 8 ký tự"/>

                <Label styleClass="muted-label" style="-fx-font-size: 12;" text="Xác nhận mật khẩu mới"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu"/>

                <Region prefHeight="4"/>

                <Button maxWidth="Infinity" prefHeight="44.0" styleClass="button-primary"
                        mnemonicParsing="false" onAction="#handleReset" text="ĐẶT LẠI MẬT KHẨU"/>
            </VBox>

            <Label fx:id="messageLabel" maxWidth="360.0" styleClass="info-label" wrapText="true"
                   style="-fx-text-alignment: center;"/>

            <HBox alignment="CENTER" spacing="6.0">
                <Label styleClass="muted-label" text="Đã nhớ mật khẩu?"/>
                <Hyperlink text="Đăng nhập" onAction="#goToLogin"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
