<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.AdminController">
<BorderPane styleClass="admin-root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="admin-top-nav">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8" prefWidth="200">
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Label style="-fx-text-fill: #4285F4; -fx-font-size: 20; -fx-font-weight: bold;" text="A"/>
                    <Label style="-fx-text-fill: #EA4335; -fx-font-size: 20; -fx-font-weight: bold;" text="u"/>
                    <Label style="-fx-text-fill: #FBBC05; -fx-font-size: 20; -fx-font-weight: bold;" text="c"/>
                    <Label style="-fx-text-fill: #4285F4; -fx-font-size: 20; -fx-font-weight: bold;" text="t"/>
                    <Label style="-fx-text-fill: #34A853; -fx-font-size: 20; -fx-font-weight: bold;" text="r"/>
                    <Label style="-fx-text-fill: #EA4335; -fx-font-size: 20; -fx-font-weight: bold;" text="a"/>
                </HBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" styleClass="admin-search-box" prefWidth="400">
                <Label styleClass="admin-search-icon" text="🔍"/>
                <TextField fx:id="globalSearchField" styleClass="admin-search-field"
                           HBox.hgrow="ALWAYS" promptText="Tìm kiếm..."/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="20">
                <HBox alignment="CENTER" spacing="8">
                    <StackPane styleClass="admin-user-avatar">
                        <Label fx:id="userInitialsLabel" styleClass="admin-user-avatar-text" text="A"/>
                    </StackPane>
                    <Label fx:id="topBarGreeting" styleClass="admin-user-name" text="admin_demo"/>
                    <Label styleClass="admin-user-name" text="v" style="-fx-font-size: 10;"/>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox spacing="4" styleClass="admin-sidebar" prefWidth="240">
            <padding><Insets top="24" right="16" bottom="24" left="16"/></padding>
            <Button fx:id="navDashboard" styleClass="nav-link-active" mnemonicParsing="false"
                    onAction="#handleShowDashboard" text="📊  Tổng quan" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
            <Button fx:id="navUsers" styleClass="nav-link" mnemonicParsing="false"
                    onAction="#handleShowUsers" text="👥  Người dùng" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
            <Button fx:id="navAuctions" styleClass="nav-link" mnemonicParsing="false"
                    onAction="#handleShowAuctions" text="🔨  Phiên đấu giá" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" styleClass="admin-main-bg">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="admin-content-header">
                <padding><Insets top="16" right="32" bottom="16" left="32"/></padding>
                <Label styleClass="admin-breadcrumb-text" text="Trang chủ"/>
                <Label styleClass="admin-breadcrumb-sep" text="›"/>
                <Label styleClass="admin-breadcrumb-text" text="Quản trị"/>
                <Label styleClass="admin-breadcrumb-sep" text="›"/>
                <Label styleClass="admin-breadcrumb-active" text="Tổng quan"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button styleClass="button-ghost" mnemonicParsing="false"
                        onAction="#handleBackToLogin" text="Đăng xuất"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="admin-scroll">
                <VBox spacing="24">
                    <padding><Insets top="8" right="32" bottom="32" left="32"/></padding>
                    <Label fx:id="welcomeLabel" styleClass="admin-page-title" text="Xin chao, Admin"/>
                    
                    <Label fx:id="actionMessageLabel" styleClass="info-label" wrapText="true"/>

                    <VBox fx:id="dashboardSection" spacing="16">
                        <HBox spacing="16.0">
                            <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS" spacing="10">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <VBox spacing="2">
                                        <Label styleClass="stat-card-label" text="Tổng người dùng"/>
                                        <Label fx:id="statTotalUsers" styleClass="stat-card-value" text="0"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                            <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS" spacing="10">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <VBox spacing="2">
                                        <Label styleClass="stat-card-label" text="Đang diễn ra"/>
                                        <Label fx:id="statRunningAuctions" styleClass="stat-card-value-warning" text="0"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                            <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS" spacing="10">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <VBox spacing="2">
                                        <Label styleClass="stat-card-label" text="Đã thanh toán"/>
                                        <Label fx:id="statPaidAuctions" styleClass="stat-card-value-success" text="0"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                            <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS" spacing="10">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <VBox spacing="2">
                                        <Label styleClass="stat-card-label" text="Tổng doanh thu"/>
                                        <Label fx:id="statRevenue" styleClass="stat-card-value-accent" text="0"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox fx:id="usersSection" styleClass="admin-card" spacing="0" visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-card-header">
                            <Label styleClass="admin-card-title" text="Người dùng"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <HBox alignment="CENTER_LEFT" styleClass="admin-inner-search">
                                <TextField fx:id="userSearchField" styleClass="admin-inner-search-field"
                                           prefWidth="220.0" promptText="Tìm người dùng..."/>
                            </HBox>
                        </HBox>
                        <TableView fx:id="userTable" prefHeight="440.0" styleClass="admin-table">
                            <columns>
                                <TableColumn fx:id="userIdColumn"   prefWidth="200.0" text="Mã người dùng"/>
                                <TableColumn fx:id="usernameColumn" prefWidth="180.0" text="Tên đăng nhập"/>
                                <TableColumn fx:id="emailColumn"    prefWidth="260.0" text="Email"/>
                                <TableColumn fx:id="roleColumn"     prefWidth="140.0" text="Vai trò"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox fx:id="auctionsSection" styleClass="admin-card" spacing="0" visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="admin-card-header">
                            <Label styleClass="admin-card-title" text="Phiên đấu giá"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <HBox alignment="CENTER_LEFT" styleClass="admin-inner-search">
                                <TextField fx:id="auctionSearchField" styleClass="admin-inner-search-field"
                                           prefWidth="220.0" promptText="Tìm phiên đấu giá..."/>
                            </HBox>
                            <Button styleClass="button-danger button-row" mnemonicParsing="false"
                                    onAction="#handleCancelAuction" text="Huỷ"/>
                            <Button styleClass="button-success button-row" mnemonicParsing="false"
                                    onAction="#handleMarkPaid" text="Đã TT"/>
                        </HBox>
                        <TableView fx:id="auctionTable" prefHeight="440.0" styleClass="admin-table">
                            <columns>
                                <TableColumn fx:id="auctionIdColumn"    prefWidth="180.0" text="Mã phiên"/>
                                <TableColumn fx:id="itemColumn"         prefWidth="220.0" text="Vật phẩm"/>
                                <TableColumn fx:id="sellerColumn"       prefWidth="180.0" text="Người bán"/>
                                <TableColumn fx:id="statusColumn"       prefWidth="140.0" text="Trạng thái"/>
                                <TableColumn fx:id="currentPriceColumn" prefWidth="140.0" text="Giá hiện tại"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </ScrollPane>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-footer">
                <Label styleClass="admin-footer-text" text="© 2026 Auctra"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="admin-footer-text" text="Báo cáo · Cài đặt hệ thống"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
</StackPane>