<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.AuctionDetailController">
<BorderPane styleClass="admin-root">

    <!-- ═══════ TOP NAV ═══════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="admin-top-nav">
            <padding><Insets top="12" right="28" bottom="12" left="28"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10" prefWidth="220">
                <StackPane styleClass="brand-mark">
                    <Label styleClass="brand-mark-text" text="A"/>
                </StackPane>
                <VBox spacing="0">
                    <Label styleClass="brand-word" text="Auctra"/>
                    <Label styleClass="brand-tag" text="Chi tiết phiên"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="16">
                <HBox alignment="CENTER" spacing="6" styleClass="notification-pill">
                    <Label text="Lượt giá"/>
                    <Label styleClass="notification-badge" text="0"/>
                </HBox>
                <HBox alignment="CENTER" spacing="8">
                    <StackPane styleClass="admin-user-avatar">
                        <Label fx:id="detailUserInitialsLabel" styleClass="admin-user-avatar-text" text="U"/>
                    </StackPane>
                    <Label fx:id="detailUserNameLabel" styleClass="admin-user-name" text="User"/>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- ═══════ SIDEBAR ═══════ -->
    <left>
        <VBox spacing="4" styleClass="admin-sidebar" prefWidth="240">
            <padding><Insets top="24" right="16" bottom="24" left="16"/></padding>
            <Label styleClass="sidebar-section-label" text="ĐIỀU HƯỚNG"/>
            <Button styleClass="nav-link" mnemonicParsing="false"
                    onAction="#handleBack" text="← Quay lại" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
            <Region prefHeight="16"/>
            <Label styleClass="sidebar-section-label" text="PHIÊN HIỆN TẠI"/>
            <!-- Auction name summary in sidebar -->
            <VBox styleClass="sidebar-user-card" spacing="6">
                <Label fx:id="itemNameLabel" styleClass="sidebar-user-name" wrapText="true"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label fx:id="itemTypeChip" styleClass="chip-info" text="Category"/>
                    <Label fx:id="statusLabel" styleClass="badge" text="OPEN"/>
                </HBox>
                <Label fx:id="bidCountChip" styleClass="chip" text="0 lượt"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="sidebar-user-card" spacing="3">
                <Label styleClass="sidebar-user-name" text="Phiên đang xem"/>
                <Label styleClass="sidebar-user-meta" text="Theo dõi realtime"/>
            </VBox>
        </VBox>
    </left>

    <!-- ═══════ MAIN CONTENT ═══════ -->
    <center>
        <VBox spacing="0" styleClass="admin-main-bg">

            <!-- Breadcrumb -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="admin-content-header">
                <padding><Insets top="16" right="32" bottom="16" left="32"/></padding>
                <Label styleClass="admin-breadcrumb-text" text="Trang chủ"/>
                <Label styleClass="admin-breadcrumb-sep" text="/"/>
                <Label styleClass="admin-breadcrumb-text" text="Phiên đấu giá"/>
                <Label styleClass="admin-breadcrumb-sep" text="/"/>
                <Label styleClass="admin-breadcrumb-active" text="Chi tiết"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button styleClass="button-ghost" mnemonicParsing="false"
                        onAction="#handleRefresh" text="Làm mới"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="admin-scroll">
                <VBox spacing="24">
                    <padding><Insets top="24" right="32" bottom="32" left="32"/></padding>

                    <!-- ─── Price Chart Card ─── -->
                    <VBox styleClass="admin-card chart-card live-chart-card" spacing="8">
                        <padding><Insets top="24" right="24" bottom="18" left="24"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label styleClass="admin-card-title" text="Biểu đồ giá realtime"/>
                            <Label styleClass="chip-success" text="LIVE"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="realtimeStatusLabel" styleClass="muted-label" text="Đang theo dõi giá"/>
                        </HBox>
                        <LineChart fx:id="priceLineChart" legendVisible="false" createSymbols="true" animated="false">
                            <xAxis>
                                <CategoryAxis fx:id="chartXAxis" label="Mốc trả giá"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="chartYAxis" label="Giá ($)" forceZeroInRange="false"/>
                            </yAxis>
                        </LineChart>
                    </VBox>

                    <!-- ─── Detail Grid: 3 columns ─── -->
                    <HBox spacing="22" alignment="TOP_LEFT">

                        <!-- COLUMN 1: Image + Description -->
                        <VBox spacing="18" prefWidth="380" minWidth="320">
                            <StackPane styleClass="detail-image-wrapper" prefHeight="390" minHeight="320">
                                <ImageView fx:id="itemImageView" fitWidth="360" fitHeight="340"
                                           preserveRatio="true" smooth="true"/>
                                <Label fx:id="imagePlaceholderLabel" styleClass="image-placeholder-large" text="A"/>
                            </StackPane>
                            <FlowPane fx:id="thumbnailContainer" hgap="8" vgap="8"
                                      styleClass="detail-thumbnail-strip" prefWrapLength="360"/>

                            <VBox styleClass="admin-card" spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-card-header">
                                    <Label styleClass="admin-card-title" text="Mô tả sản phẩm"/>
                                </HBox>
                                <VBox>
                                    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                                    <Label fx:id="itemDescriptionLabel" styleClass="muted-label" wrapText="true"/>
                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- COLUMN 2: Price + Bid Forms -->
                        <VBox spacing="18" HBox.hgrow="ALWAYS" minWidth="360" styleClass="detail-main-column">

                            <!-- Price Card -->
                            <VBox styleClass="admin-card" spacing="12">
                                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                                <Label styleClass="muted-label" text="Giá hiện tại"/>
                                <Label fx:id="currentPriceLabel" styleClass="price-big"/>
                                <Label fx:id="startingPriceLabel" styleClass="muted-label"/>
                                <Label fx:id="countdownLabel" styleClass="muted-label" text="Thời gian còn lại: --:--"/>
                                <ProgressBar fx:id="progressBar" progress="0.62" maxWidth="Infinity"/>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label styleClass="muted-label" text="Người thắng hiện tại:"/>
                                    <Label fx:id="winnerLabel" styleClass="admin-card-title" text="Chưa có"/>
                                </HBox>
                            </VBox>

                            <!-- Thao tác group header -->
                            <VBox spacing="14">
                                <Label styleClass="section-title" text="Thao tác"/>

                                <!-- Auto-Bid Form -->
                                <VBox fx:id="autoBidFormPanel" styleClass="admin-card" spacing="12">
                                    <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
                                    <Label styleClass="admin-card-title" text="Tự động đấu giá (Auto-Bid)"/>
                                    <Label fx:id="autoBidStatusLabel" styleClass="muted-label" text="Trạng thái: Chưa kích hoạt"/>
                                    <HBox spacing="10">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label text="Giá tối đa (Max Bid)" styleClass="muted-label"/>
                                            <TextField fx:id="autoBidMaxField" promptText="Ví dụ: 2000" styleClass="bid-input"/>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label text="Bước nâng (Increment)" styleClass="muted-label"/>
                                            <TextField fx:id="autoBidIncrementField" promptText="Mặc định: 10" styleClass="bid-input"/>
                                        </VBox>
                                    </HBox>
                                    <Button fx:id="toggleAutoBidButton" styleClass="button-success button-full"
                                            maxWidth="Infinity" mnemonicParsing="false"
                                            onAction="#handleToggleAutoBid" text="Kích hoạt Auto-Bid"/>
                                </VBox>

                                <!-- Manual Bid Form -->
                                <VBox fx:id="bidFormPanel" styleClass="admin-card bid-card" spacing="12">
                                    <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
                                    <Label styleClass="admin-card-title" text="Đặt giá của bạn"/>
                                    <Label fx:id="bidHintLabel" styleClass="muted-label" wrapText="true"/>
                                    <TextField fx:id="bidAmountField" promptText="Nhập số tiền" styleClass="bid-input"/>
                                    <HBox spacing="8">
                                        <Button styleClass="bid-chip button-row" maxWidth="Infinity"
                                                HBox.hgrow="ALWAYS" mnemonicParsing="false"
                                                onAction="#bidPlusSmall" text="+10"/>
                                        <Button styleClass="bid-chip button-row" maxWidth="Infinity"
                                                HBox.hgrow="ALWAYS" mnemonicParsing="false"
                                                onAction="#bidPlusMedium" text="+100"/>
                                        <Button styleClass="bid-chip button-row" maxWidth="Infinity"
                                                HBox.hgrow="ALWAYS" mnemonicParsing="false"
                                                onAction="#bidPlusLarge" text="+1,000"/>
                                    </HBox>
                                    <Button fx:id="placeBidButton" styleClass="button-primary button-full"
                                            maxWidth="Infinity" mnemonicParsing="false"
                                            onAction="#handlePlaceBid" text="Đặt giá ngay"/>
                                </VBox>
                            </VBox>

                            <!-- Meta rows — expanded -->
                            <VBox spacing="2">
                                <HBox styleClass="meta-row" alignment="CENTER_LEFT">
                                    <Label styleClass="meta-key" text="Người bán"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="sellerLabel" styleClass="meta-value"/>
                                </HBox>
                                <HBox styleClass="meta-row" alignment="CENTER_LEFT">
                                    <Label styleClass="meta-key" text="Loại phiên"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label styleClass="meta-value" text="Realtime"/>
                                </HBox>
                                <HBox styleClass="meta-row" alignment="CENTER_LEFT">
                                    <Label styleClass="meta-key" text="Phương thức"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label styleClass="meta-value" text="Trả giá cao nhất"/>
                                </HBox>
                                <HBox styleClass="meta-row" alignment="CENTER_LEFT">
                                    <Label styleClass="meta-key" text="Cập nhật"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label styleClass="meta-value" text="Realtime"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- COLUMN 3: Bid History -->
                        <VBox styleClass="history-card detail-history-column" spacing="0" prefWidth="340" minWidth="290">
                            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-card-header">
                                <Label styleClass="admin-card-title" text="Lịch sử đặt giá"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="bidCountLabel" styleClass="muted-label" text="0 lượt"/>
                            </HBox>
                            <TableView fx:id="bidTable" prefHeight="600" styleClass="admin-table">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="bidIndexColumn" prefWidth="50.0" text="#"/>
                                    <TableColumn fx:id="bidderColumn" prefWidth="120.0" text="Người đặt"/>
                                    <TableColumn fx:id="bidAmountColumn" prefWidth="110.0" text="Số tiền"/>
                                    <TableColumn fx:id="bidTimeColumn" prefWidth="150.0" text="Thời điểm"/>
                                </columns>
                            </TableView>
                        </VBox>

                    </HBox>

                </VBox>
            </ScrollPane>

            <!-- Footer -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-footer">
                <Label styleClass="admin-footer-text" text="© 2026 Auctra — Hệ thống đấu giá trực tuyến"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="admin-footer-text" text="Điều khoản · Trợ giúp · Liên hệ"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
</StackPane>
