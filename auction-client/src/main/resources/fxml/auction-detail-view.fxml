<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.*?>
<?import com.auction.ui.ResponsiveColumns?>
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="detail-page" fx:id="rootPane" fx:controller="com.auction.controller.AuctionDetailController">
    <BorderPane styleClass="admin-root">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-top-nav">
                <StackPane styleClass="brand-mark">
                    <Label text="A" styleClass="brand-mark-text"/>
                </StackPane>
                <Label text="Auctra" styleClass="brand-word" wrapText="true" minWidth="0"/>
                <Label text="Chi tiết phiên" styleClass="brand-tag" wrapText="true" minWidth="0"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Sáng / tối" onAction="#handleToggleTheme" styleClass="button-ghost" mnemonicParsing="false"/>
                <StackPane styleClass="admin-user-avatar">
                    <Label fx:id="detailUserInitialsLabel" text="U" styleClass="admin-user-avatar-text" wrapText="true" minWidth="0"/>
                </StackPane>
            </HBox>
        </top>
        <left>
            <VBox spacing="6" prefWidth="192" minWidth="176" styleClass="admin-sidebar">
                <Button text="Quay lại danh sách" onAction="#handleBack" styleClass="nav-link-active" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Region VBox.vgrow="ALWAYS"/>
                <VBox spacing="4" styleClass="sidebar-user-card">
                    <Label fx:id="sidebarUserNameLabel" text="" styleClass="sidebar-user-name" wrapText="true" minWidth="0"/>
                    <Label fx:id="sidebarUserMetaLabel" text="" styleClass="sidebar-user-meta" wrapText="true" minWidth="0"/>
                </VBox>
                <Button text="Danh sách phiên" onAction="#handleBack" styleClass="nav-link" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            </VBox>
        </left>
        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
                <VBox spacing="24" minWidth="0" styleClass="page-content">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label fx:id="itemNameLabel" styleClass="screen-title" wrapText="true" minWidth="0" HBox.hgrow="ALWAYS"/>
                        <Button text="Làm mới" onAction="#handleRefresh" styleClass="button-ghost" mnemonicParsing="false"/>
                    </HBox>
                    <FlowPane hgap="10" vgap="8">
                        <Label fx:id="itemTypeChip" text="" styleClass="chip-info" wrapText="true" minWidth="0"/>
                        <Label fx:id="statusLabel" text="" styleClass="badge" wrapText="true" minWidth="0"/>
                        <Label fx:id="bidCountChip" text="" styleClass="muted-label" wrapText="true" minWidth="0"/>
                    </FlowPane>
                    <ResponsiveColumns breakpoint="720" compactReverse="true">
                        <VBox spacing="16" minWidth="0">
                            <StackPane styleClass="detail-image-wrapper" prefHeight="280" minWidth="0">
                                <ImageView fx:id="itemImageView" fitWidth="340" fitHeight="250" preserveRatio="true" smooth="true"/>
                                <Label fx:id="imagePlaceholderLabel" text="Người bán chưa cung cấp ảnh" styleClass="image-placeholder-large" wrapText="true" minWidth="0"/>
                            </StackPane>
                            <FlowPane fx:id="thumbnailContainer" hgap="8" vgap="8" minWidth="0"/>
                            <Label text="Mô tả vật phẩm" styleClass="section-title" wrapText="true" minWidth="0"/>
                            <Label fx:id="itemDescriptionLabel" text="" styleClass="body-copy" wrapText="true" minWidth="0"/>
                            <HBox spacing="10">
                                <Label text="Người bán" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <Label fx:id="sellerLabel" text="" styleClass="meta-value" wrapText="true" minWidth="0"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="18" minWidth="0" styleClass="bid-workspace">
                            <VBox spacing="8">
                                <Label text="Giá hiện tại" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <Label fx:id="currentPriceLabel" text="" styleClass="price-big" wrapText="true" minWidth="0"/>
                                <Label fx:id="startingPriceLabel" text="" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <Label fx:id="countdownLabel" text="Đang đọc thời gian kết thúc…" styleClass="countdown" wrapText="true" minWidth="0"/>
                                <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity"/>
                                <HBox spacing="8">
                                    <Label text="Đang dẫn đầu:" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                    <Label fx:id="winnerLabel" text="Chưa có" styleClass="meta-value" wrapText="true" minWidth="0"/>
                                </HBox>
                            </VBox>
                            <Separator/>
                            <VBox fx:id="bidFormPanel" spacing="10" minWidth="0">
                                <Label text="Đặt giá" styleClass="section-title" wrapText="true" minWidth="0"/>
                                <Label fx:id="bidHintLabel" text="" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <VBox spacing="6" minWidth="0">
                                    <Label text="Số tiền đặt giá ($)" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${bidAmountField}"/>
                                    <TextField fx:id="bidAmountField" promptText="Ví dụ: 1300" maxWidth="Infinity" minWidth="0" onAction="#handlePlaceBid"/>
                                </VBox>
                                <FlowPane hgap="8" vgap="8">
                                    <Button text="+10" onAction="#bidPlusSmall" styleClass="bid-chip" mnemonicParsing="false"/>
                                    <Button text="+100" onAction="#bidPlusMedium" styleClass="bid-chip" mnemonicParsing="false"/>
                                    <Button text="+1.000" onAction="#bidPlusLarge" styleClass="bid-chip" mnemonicParsing="false"/>
                                </FlowPane>
                                <Button fx:id="placeBidButton" text="Đặt giá" onAction="#handlePlaceBid" styleClass="button-primary" mnemonicParsing="false" maxWidth="Infinity"/>
                            </VBox>
                            <VBox fx:id="autoBidFormPanel" spacing="10" minWidth="0" styleClass="auto-bid-section">
                                <Label text="Tự động đặt giá" styleClass="section-title" wrapText="true" minWidth="0"/>
                                <Label text="Đặt giới hạn và bước nâng. Hệ thống trả giá khi có người vượt bạn, trong giới hạn đã chọn." styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <Label fx:id="autoBidStatusLabel" text="Chưa kích hoạt" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <ResponsiveColumns breakpoint="350" gap="12">
                                    <VBox spacing="6" minWidth="0">
                                        <Label text="Giới hạn ($)" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${autoBidMaxField}"/>
                                        <TextField fx:id="autoBidMaxField" promptText="Ví dụ: 2000" maxWidth="Infinity" minWidth="0"/>
                                    </VBox>
                                    <VBox spacing="6" minWidth="0">
                                        <Label text="Bước nâng ($)" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${autoBidIncrementField}"/>
                                        <TextField fx:id="autoBidIncrementField" promptText="Ví dụ: 10" maxWidth="Infinity" minWidth="0"/>
                                    </VBox>
                                </ResponsiveColumns>
                                <Button fx:id="toggleAutoBidButton" text="Bật tự động đặt giá" onAction="#handleToggleAutoBid" styleClass="button-ghost" mnemonicParsing="false" maxWidth="Infinity"/>
                            </VBox>
                        </VBox>
                    </ResponsiveColumns>
                    <VBox spacing="12" minWidth="0" styleClass="history-section">
                        <HBox spacing="12">
                            <Label text="Lịch sử đặt giá" styleClass="section-title" wrapText="true" minWidth="0"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="bidCountLabel" text="0 lượt" styleClass="muted-label" wrapText="true" minWidth="0"/>
                        </HBox>
                        <TableView fx:id="bidTable" prefHeight="260" minWidth="0" styleClass="admin-table">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="bidIndexColumn" text="#" prefWidth="40"/>
                                <TableColumn fx:id="bidderColumn" text="Người đặt" prefWidth="160"/>
                                <TableColumn fx:id="bidAmountColumn" text="Số tiền ($)" prefWidth="150"/>
                                <TableColumn fx:id="bidTimeColumn" text="Thời điểm" prefWidth="180"/>
                            </columns>
                        </TableView>
                    </VBox>
                    <VBox spacing="12" minWidth="0">
                        <Label text="Diễn biến giá" styleClass="section-title" wrapText="true" minWidth="0"/>
                        <Label fx:id="realtimeStatusLabel" text="" styleClass="muted-label" wrapText="true" minWidth="0"/>
                        <LineChart fx:id="priceLineChart" legendVisible="false" createSymbols="true" animated="false" prefHeight="260" minHeight="200" minWidth="0">
                            <xAxis>
                                <CategoryAxis fx:id="chartXAxis" label="Lượt đặt giá"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="chartYAxis" label="Giá ($)" forceZeroInRange="false"/>
                            </yAxis>
                        </LineChart>
                    </VBox>
                    <Label fx:id="detailUserNameLabel" visible="false" managed="false"/>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>
