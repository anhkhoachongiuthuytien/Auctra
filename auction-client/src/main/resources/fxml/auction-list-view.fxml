<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.AuctionController">
<BorderPane styleClass="admin-root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="admin-top-nav">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8" prefWidth="200">
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Label style="-fx-text-fill: #4285F4; -fx-font-size: 20; -fx-font-weight: bold;" text="A"/>
                    <Label style="-fx-text-fill: #EA4335; -fx-font-size: 20; -fx-font-weight: bold;" text="u"/>
                    <Label style="-fx-text-fill: #FBBC05; -fx-font-size: 20; -fx-font-weight: bold;" text="c"/>
                    <Label style="-fx-text-fill: #4285F4; -fx-font-size: 20; -fx-font-weight: bold;" text="t"/>
                    <Label style="-fx-text-fill: #34A853; -fx-font-size: 20; -fx-font-weight: bold;" text="r"/>
                    <Label style="-fx-text-fill: #EA4335; -fx-font-size: 20; -fx-font-weight: bold;" text="a"/>
                </HBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" styleClass="admin-search-box" prefWidth="400">
                <Label styleClass="admin-search-icon" text="&#128269;"/>
                <TextField styleClass="admin-search-field" promptText="Tìm kiếm..." HBox.hgrow="ALWAYS"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="20">
                <HBox alignment="CENTER" spacing="8">
                    <StackPane fx:id="userAvatar" styleClass="admin-user-avatar">
                        <Label fx:id="userInitialsLabel" styleClass="admin-user-avatar-text" text="U"/>
                    </StackPane>
                    <Label styleClass="admin-user-name" text="Bidder"/>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox spacing="4" styleClass="admin-sidebar" prefWidth="240">
            <padding><Insets top="24" right="16" bottom="24" left="16"/></padding>
            <Button fx:id="navAuctions" styleClass="nav-link-active" mnemonicParsing="false"
                    onAction="#goToAuctions" text="🔨  Phiên đấu giá" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
            <Button fx:id="navProfile" styleClass="nav-link" mnemonicParsing="false"
                    onAction="#goToProfile" text="👤  Tài khoản" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button styleClass="nav-link" mnemonicParsing="false"
                    onAction="#handleBackToLogin" text="🚪  Đăng xuất" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" styleClass="admin-main-bg">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="admin-content-header">
                <padding><Insets top="16" right="32" bottom="16" left="32"/></padding>
                <Label styleClass="admin-breadcrumb-text" text="Trang chủ"/>
                <Label styleClass="admin-breadcrumb-sep" text="›"/>
                <Label styleClass="admin-breadcrumb-active" text="Phiên đấu giá"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="refreshButton" styleClass="button-ghost" mnemonicParsing="false"
                        onAction="#handleRefresh" text="Làm mới"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="admin-scroll">
                <VBox spacing="24">
                    <padding><Insets top="8" right="32" bottom="32" left="32"/></padding>

                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox spacing="6">
                            <Label fx:id="welcomeLabel" styleClass="admin-page-title" text="Khám phá các phiên đấu giá"/>
                            <Label fx:id="summaryLabel" styleClass="muted-label" text="Hàng loạt sản phẩm đang chờ bạn đặt giá"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="actionMessageLabel" styleClass="info-label" wrapText="true"/>

                    <VBox styleClass="admin-card" spacing="0" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-card-header">
                            <Label styleClass="admin-card-title" text="Danh sách đấu giá"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button fx:id="tabAll"      styleClass="filter-tab"        text="Tất cả"
                                        mnemonicParsing="false" onAction="#handleFilterAll"/>
                                <Button fx:id="tabActive"   styleClass="filter-tab-active" text="Đang diễn ra"
                                        mnemonicParsing="false" onAction="#handleFilterActive"/>
                                <Button fx:id="tabFinished" styleClass="filter-tab"        text="Đã kết thúc"
                                        mnemonicParsing="false" onAction="#handleFilterFinished"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" styleClass="admin-inner-search">
                                <TextField fx:id="searchField" styleClass="admin-inner-search-field"
                                           prefWidth="220.0" promptText="Tìm vật phẩm..."/>
                            </HBox>
                        </HBox>

                        <VBox spacing="0" style="-fx-padding: 0;">
                            <TableView fx:id="auctionTable" prefHeight="440.0" styleClass="admin-table">
                                <columns>
                                    <TableColumn fx:id="idColumn"      prefWidth="160.0" text="Mã phiên"/>
                                    <TableColumn fx:id="itemColumn"    prefWidth="220.0" text="Vật phẩm"/>
                                    <TableColumn fx:id="sellerColumn"  prefWidth="160.0" text="Người bán"/>
                                    <TableColumn fx:id="statusColumn"  prefWidth="130.0" text="Trạng thái"/>
                                    <TableColumn fx:id="priceColumn"   prefWidth="140.0" text="Giá hiện tại"/>
                                    <TableColumn fx:id="actionColumn"  prefWidth="220.0" text="Hành động"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>

                </VBox>
            </ScrollPane>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-footer">
                <Label styleClass="admin-footer-text" text="© 2026 Auctra"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="admin-footer-text" text="Điều khoản · Trợ giúp · Liên hệ"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
</StackPane>