<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.AuctionController">
<BorderPane styleClass="admin-root">

    <!-- ═══════ TOP NAV ═══════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="admin-top-nav">
            <padding><Insets top="12" right="28" bottom="12" left="28"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10" prefWidth="220">
                <StackPane styleClass="brand-mark">
                    <Label styleClass="brand-mark-text" text="A"/>
                </StackPane>
                <VBox spacing="0">
                    <Label styleClass="brand-word" text="Auctra"/>
                    <Label styleClass="brand-tag" text="Bidder"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" styleClass="admin-search-box" prefWidth="420">
                <TextField fx:id="topbarSearchField" styleClass="admin-search-field"
                           promptText="Tìm kiếm phiên đấu giá..." HBox.hgrow="ALWAYS"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="16">
                <HBox alignment="CENTER" spacing="6" styleClass="notification-pill">
                    <Label text="Thông báo"/>
                    <Label styleClass="notification-badge" text="0"/>
                </HBox>
                <HBox alignment="CENTER" spacing="8" onMouseClicked="#goToProfile" style="-fx-cursor: hand;">
                    <StackPane fx:id="userAvatar" styleClass="admin-user-avatar">
                        <Label fx:id="userInitialsLabel" styleClass="admin-user-avatar-text" text="U"/>
                    </StackPane>
                    <Label styleClass="admin-user-name" text="Bidder"/>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- ═══════ SIDEBAR ═══════ -->
    <left>
        <VBox spacing="4" styleClass="admin-sidebar" prefWidth="240">
            <padding><Insets top="24" right="16" bottom="24" left="16"/></padding>
            <Label styleClass="sidebar-section-label" text="MENU"/>
            <Button fx:id="navAuctions" styleClass="nav-link-active" mnemonicParsing="false"
                    onAction="#goToAuctions" text="Phiên đấu giá" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
            <Button fx:id="navProfile" styleClass="nav-link" mnemonicParsing="false"
                    onAction="#goToProfile" text="Tài khoản" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="sidebar-user-card" spacing="3" onMouseClicked="#goToProfile" style="-fx-cursor: hand;">
                <Label fx:id="sidebarUserNameLabel" styleClass="sidebar-user-name" text="Bidder"/>
                <Label fx:id="sidebarUserMetaLabel" styleClass="sidebar-user-meta" text="Sẵn sàng đặt giá"/>
            </VBox>
            <Button styleClass="nav-link" mnemonicParsing="false"
                    onAction="#handleBackToLogin" text="Đăng xuất" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- ═══════ MAIN CONTENT ═══════ -->
    <center>
        <VBox spacing="0" styleClass="admin-main-bg">

            <!-- Breadcrumb -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="admin-content-header">
                <padding><Insets top="16" right="32" bottom="16" left="32"/></padding>
                <Label styleClass="admin-breadcrumb-text" text="Trang chủ"/>
                <Label styleClass="admin-breadcrumb-sep" text="/"/>
                <Label styleClass="admin-breadcrumb-active" text="Phiên đấu giá"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="refreshButton" styleClass="button-ghost" mnemonicParsing="false"
                        onAction="#handleRefresh" text="Làm mới"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="admin-scroll">
                <VBox spacing="24">
                    <padding><Insets top="24" right="32" bottom="32" left="32"/></padding>

                    <!-- ─── Welcome Hero ─── -->
                    <HBox alignment="CENTER_LEFT" spacing="24" styleClass="welcome-header">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="welcomeLabel" styleClass="welcome-title" text="Khám phá các phiên đấu giá"/>
                            <Label fx:id="summaryLabel" styleClass="welcome-subtitle" text="Hàng loạt sản phẩm đang chờ bạn đặt giá"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="welcome-meta-box">
                            <Label styleClass="chip-success" text="LIVE"/>
                            <VBox spacing="2">
                                <Label styleClass="welcome-subtitle" style="-fx-font-weight: bold;" text="Realtime bidding"/>
                                <Label styleClass="welcome-subtitle" text="Cập nhật tức thì"/>
                            </VBox>
                        </HBox>
                    </HBox>

                    <!-- Hidden label for controller binding -->
                    <Label fx:id="selectedAuctionLabel" visible="false" managed="false"/>

                    <!-- Action message -->
                    <Label fx:id="actionMessageLabel" styleClass="info-label" wrapText="true"/>

                    <!-- ─── Auction Grid Card ─── -->
                    <VBox styleClass="admin-card" spacing="0" VBox.vgrow="ALWAYS">
                        <!-- Card header with filters -->
                        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="admin-card-header">
                            <Label styleClass="admin-card-title" text="Danh sách đấu giá"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <HBox spacing="8" alignment="CENTER_RIGHT">
                                <Button fx:id="tabAll" styleClass="filter-tab" text="Tất cả"
                                        mnemonicParsing="false" onAction="#handleFilterAll"/>
                                <Button fx:id="tabActive" styleClass="filter-tab-active" text="Đang diễn ra"
                                        mnemonicParsing="false" onAction="#handleFilterActive"/>
                                <Button fx:id="tabFinished" styleClass="filter-tab" text="Đã kết thúc"
                                        mnemonicParsing="false" onAction="#handleFilterFinished"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" styleClass="admin-inner-search">
                                <TextField fx:id="searchField" styleClass="admin-inner-search-field"
                                           prefWidth="220.0" promptText="Tìm vật phẩm..."/>
                            </HBox>
                        </HBox>

                        <!-- Auction grid — no constraining inner ScrollPane -->
                        <VBox>
                            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                            <FlowPane fx:id="auctionGrid" hgap="16" vgap="16" styleClass="auction-grid">
                                <!-- Dynamic cards go here -->
                            </FlowPane>
                        </VBox>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- Footer -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-footer">
                <Label styleClass="admin-footer-text" text="© 2026 Auctra — Hệ thống đấu giá trực tuyến"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="admin-footer-text" text="Điều khoản · Trợ giúp · Liên hệ"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
</StackPane>
