<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.*?>
<?import com.auction.ui.ResponsiveColumns?>
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:id="rootPane" fx:controller="com.auction.controller.AuctionController">
    <BorderPane styleClass="admin-root">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-top-nav">
                <StackPane styleClass="brand-mark">
                    <Label text="A" styleClass="brand-mark-text"/>
                </StackPane>
                <Label text="Auctra" styleClass="brand-word" wrapText="true" minWidth="0"/>
                <Label text="Phiên đấu giá" styleClass="brand-tag" wrapText="true" minWidth="0"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Sáng / tối" onAction="#handleToggleTheme" styleClass="button-ghost" mnemonicParsing="false"/>
                <Button text="Tài khoản" onAction="#goToProfile" styleClass="button-ghost" mnemonicParsing="false" accessibleText="Mở tài khoản"/>
                <StackPane styleClass="admin-user-avatar">
                    <Label fx:id="userInitialsLabel" text="U" styleClass="admin-user-avatar-text" wrapText="true" minWidth="0"/>
                </StackPane>
            </HBox>
        </top>
        <left>
            <VBox spacing="6" prefWidth="192" minWidth="176" styleClass="admin-sidebar">
                <Button fx:id="navAuctions" text="Phiên đấu giá" onAction="#goToAuctions" styleClass="nav-link-active" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="navProfile" text="Tài khoản" onAction="#goToProfile" styleClass="nav-link" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Region VBox.vgrow="ALWAYS"/>
                <VBox spacing="4" styleClass="sidebar-user-card">
                    <Label fx:id="sidebarUserNameLabel" text="" styleClass="sidebar-user-name" wrapText="true" minWidth="0"/>
                    <Label fx:id="sidebarUserMetaLabel" text="" styleClass="sidebar-user-meta" wrapText="true" minWidth="0"/>
                </VBox>
                <Button text="Đăng xuất" onAction="#handleBackToLogin" styleClass="nav-link" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            </VBox>
        </left>
        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
                <VBox spacing="24" minWidth="0" styleClass="page-content">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="6" minWidth="0">
                            <Label fx:id="welcomeLabel" text="Phiên đấu giá" styleClass="screen-title" wrapText="true" minWidth="0"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="refreshButton" text="Làm mới" onAction="#handleRefresh" styleClass="button-ghost" mnemonicParsing="false"/>
                    </HBox>
                    <Label fx:id="summaryLabel" text="" styleClass="muted-label" wrapText="true" minWidth="0"/>
                    <VBox spacing="6" minWidth="0">
                        <Label text="Tìm phiên đấu giá" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${searchField}"/>
                        <TextField fx:id="searchField" promptText="Tên vật phẩm hoặc người bán" maxWidth="Infinity" minWidth="0"/>
                    </VBox>
                    <FlowPane hgap="8" vgap="8">
                        <Button fx:id="tabAll" text="Tất cả" onAction="#handleFilterAll" styleClass="filter-tab" mnemonicParsing="false"/>
                        <Button fx:id="tabActive" text="Đang diễn ra" onAction="#handleFilterActive" styleClass="filter-tab-active" mnemonicParsing="false"/>
                        <Button fx:id="tabFinished" text="Đã kết thúc" onAction="#handleFilterFinished" styleClass="filter-tab" mnemonicParsing="false"/>
                    </FlowPane>
                    <Label fx:id="actionMessageLabel" text="" styleClass="info-label" wrapText="true" minWidth="0"/>
                    <Label fx:id="selectedAuctionLabel" visible="false" managed="false"/>
                    <FlowPane fx:id="auctionGrid" hgap="20" vgap="20" prefWrapLength="800" styleClass="auction-grid" minWidth="0"/>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>
