<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.*?>
<?import com.auction.ui.ResponsiveColumns?>
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:id="rootPane" fx:controller="com.auction.controller.SellerController">
    <BorderPane styleClass="admin-root">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-top-nav">
                <StackPane styleClass="brand-mark">
                    <Label text="A" styleClass="brand-mark-text"/>
                </StackPane>
                <Label text="Auctra" styleClass="brand-word" wrapText="true" minWidth="0"/>
                <Label text="Người bán" styleClass="brand-tag" wrapText="true" minWidth="0"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Sáng / tối" onAction="#handleToggleTheme" styleClass="button-ghost" mnemonicParsing="false"/>
                <Button text="Tài khoản" onAction="#goToProfile" styleClass="button-ghost" mnemonicParsing="false" accessibleText="Mở tài khoản"/>
                <StackPane styleClass="admin-user-avatar">
                    <Label fx:id="userInitialsLabel" text="U" styleClass="admin-user-avatar-text" wrapText="true" minWidth="0"/>
                </StackPane>
            </HBox>
        </top>
        <left>
            <VBox spacing="6" prefWidth="192" minWidth="176" styleClass="admin-sidebar">
                <Button text="Trang người bán" onAction="#goToMyAuctions" styleClass="nav-link-active" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button text="Tài khoản" onAction="#goToProfile" styleClass="nav-link" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Region VBox.vgrow="ALWAYS"/>
                <VBox spacing="4" styleClass="sidebar-user-card">
                    <Label fx:id="sidebarUserNameLabel" text="" styleClass="sidebar-user-name" wrapText="true" minWidth="0"/>
                    <Label fx:id="sidebarUserMetaLabel" text="" styleClass="sidebar-user-meta" wrapText="true" minWidth="0"/>
                </VBox>
                <Button text="Đăng xuất" onAction="#handleBackToLogin" styleClass="nav-link" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            </VBox>
        </left>
        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
                <VBox spacing="24" minWidth="0" styleClass="page-content">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="6" minWidth="0">
                            <Label fx:id="welcomeLabel" text="Trang người bán" styleClass="screen-title" wrapText="true" minWidth="0"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Làm mới" onAction="#handleRefresh" styleClass="button-ghost" mnemonicParsing="false"/>
                    </HBox>
                    <FlowPane hgap="28" vgap="16" styleClass="stat-strip">
                        <VBox spacing="6" prefWidth="165">
                            <Label text="Tổng số phiên" styleClass="muted-label" wrapText="true" minWidth="0"/>
                            <Label fx:id="statSellerTotal" text="0" styleClass="stat-value" wrapText="true" minWidth="0"/>
                        </VBox>
                        <VBox spacing="6" prefWidth="165">
                            <Label text="Đang diễn ra" styleClass="muted-label" wrapText="true" minWidth="0"/>
                            <Label fx:id="statSellerRunning" text="0" styleClass="stat-value" wrapText="true" minWidth="0"/>
                        </VBox>
                        <VBox spacing="6" prefWidth="165">
                            <Label text="Đã kết thúc" styleClass="muted-label" wrapText="true" minWidth="0"/>
                            <Label fx:id="statSellerFinished" text="0" styleClass="stat-value" wrapText="true" minWidth="0"/>
                        </VBox>
                        <VBox spacing="6" prefWidth="165">
                            <Label text="Đã thanh toán ($)" styleClass="muted-label" wrapText="true" minWidth="0"/>
                            <Label fx:id="statSellerRevenue" text="0" styleClass="stat-value" wrapText="true" minWidth="0"/>
                        </VBox>
                    </FlowPane>
                    <Label fx:id="actionMessageLabel" text="" styleClass="info-label" wrapText="true" minWidth="0"/>
                    <TitledPane text="Tạo phiên mới" expanded="false" animated="false" styleClass="create-auction-disclosure">
                        <VBox spacing="18" styleClass="form-section" minWidth="0">
                            <Label text="Tạo phiên đấu giá" styleClass="section-title" wrapText="true" minWidth="0"/>
                            <ResponsiveColumns breakpoint="560" gap="16">
                                <VBox spacing="6" minWidth="0">
                                    <Label text="Loại vật phẩm" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${itemTypeComboBox}"/>
                                    <ComboBox fx:id="itemTypeComboBox" promptText="Chọn loại" maxWidth="Infinity" minWidth="0"/>
                                </VBox>
                                <VBox spacing="6" minWidth="0">
                                    <Label text="Tên vật phẩm" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${itemNameField}"/>
                                    <TextField fx:id="itemNameField" promptText="Ví dụ: Máy ảnh Fujifilm X100VI" maxWidth="Infinity" minWidth="0"/>
                                </VBox>
                            </ResponsiveColumns>
                            <VBox spacing="6" minWidth="0">
                                <Label text="Mô tả và tình trạng" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${itemDescriptionField}"/>
                                <TextArea fx:id="itemDescriptionField" promptText="Tình trạng, phụ kiện đi kèm, thông tin cần biết" maxWidth="Infinity" minWidth="0" prefRowCount="3" wrapText="true"/>
                            </VBox>
                            <ResponsiveColumns breakpoint="420" gap="16">
                                <VBox spacing="6" minWidth="0">
                                    <Label text="Giá khởi điểm ($)" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${startingPriceField}"/>
                                    <TextField fx:id="startingPriceField" promptText="Ví dụ: 1200" maxWidth="Infinity" minWidth="0"/>
                                </VBox>
                                <VBox spacing="6" minWidth="0">
                                    <Label text="Thời lượng (phút)" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${durationField}"/>
                                    <TextField fx:id="durationField" promptText="Từ 1 đến 10080" maxWidth="Infinity" minWidth="0" text="5"/>
                                </VBox>
                            </ResponsiveColumns>
                            <VBox fx:id="dropZone" spacing="12" minWidth="0" styleClass="upload-zone">
                                <Label text="Ảnh vật phẩm" styleClass="field-label" wrapText="true" minWidth="0"/>
                                <Label fx:id="selectedImageLabel" text="Chọn ảnh hoặc kéo thả vào đây. Ảnh đầu tiên làm ảnh bìa." styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <FlowPane hgap="10" vgap="8">
                                    <Button text="Chọn ảnh" onAction="#handleChooseImage" styleClass="button-ghost" mnemonicParsing="false"/>
                                    <Button fx:id="clearImageBtn" text="Xóa ảnh đã chọn" onAction="#handleClearImage" styleClass="button-ghost" mnemonicParsing="false" disable="true"/>
                                </FlowPane>
                                <FlowPane fx:id="imagePreviewContainer" hgap="8" vgap="8" minWidth="0"/>
                            </VBox>
                            <Button text="Tạo phiên đấu giá" onAction="#handleCreateAuction" styleClass="button-primary" mnemonicParsing="false" maxWidth="Infinity"/>
                        </VBox>
                    </TitledPane>
                    <Label text="Phiên của bạn" styleClass="section-title" wrapText="true" minWidth="0"/>
                    <FlowPane fx:id="sellerAuctionGrid" hgap="20" vgap="20" minWidth="0" prefWrapLength="800"/>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>
