<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.SellerController">
<BorderPane styleClass="admin-root">

    <!-- ═══════════════════════════════════════════════
         TOP BAR — Brand + Notification + Avatar
         ═══════════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="admin-top-nav">
            <padding><Insets top="12" right="28" bottom="12" left="28"/></padding>

            <!-- Brand mark -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane styleClass="brand-mark">
                    <Label styleClass="brand-mark-text" text="A"/>
                </StackPane>
                <VBox spacing="0">
                    <Label styleClass="brand-word" text="Auctra"/>
                    <Label styleClass="brand-tag" text="Seller"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Notification + User avatar (fixed indentation) -->
            <HBox alignment="CENTER" spacing="16">
                <HBox alignment="CENTER" spacing="6" styleClass="notification-pill">
                    <Label text="Phiên bán"/>
                    <Label styleClass="notification-badge" text="0"/>
                </HBox>
                <HBox alignment="CENTER" spacing="8" onMouseClicked="#goToProfile" style="-fx-cursor: hand;">
                    <StackPane styleClass="admin-user-avatar">
                        <Label fx:id="userInitialsLabel" styleClass="admin-user-avatar-text" text="S"/>
                    </StackPane>
                    <Label styleClass="admin-user-name" text="Seller"/>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════════
         SIDEBAR — Navigation + user card
         ═══════════════════════════════════════════════ -->
    <left>
        <VBox spacing="4" styleClass="admin-sidebar" prefWidth="240">
            <padding><Insets top="24" right="16" bottom="24" left="16"/></padding>

            <Label styleClass="sidebar-section-label" text="MENU"/>
            <Button styleClass="nav-link-active" mnemonicParsing="false"
                    text="Trang người bán" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
            <Button styleClass="nav-link" mnemonicParsing="false"
                    onAction="#goToProfile" text="Hồ sơ" alignment="BASELINE_LEFT" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-user-card" spacing="3" onMouseClicked="#goToProfile" style="-fx-cursor: hand;">
                <Label fx:id="sidebarUserNameLabel" styleClass="sidebar-user-name" text="Seller mode"/>
                <Label fx:id="sidebarUserMetaLabel" styleClass="sidebar-user-meta" text="Quản lý phiên đấu giá"/>
            </VBox>
            <Button styleClass="nav-link" mnemonicParsing="false"
                    onAction="#handleBackToLogin" text="Đăng xuất" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════
         CENTER — Breadcrumb + ScrollPane content
         ═══════════════════════════════════════════════ -->
    <center>
        <VBox spacing="0" styleClass="admin-main-bg">

            <!-- Breadcrumb bar -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="admin-content-header">
                <padding><Insets top="16" right="32" bottom="16" left="32"/></padding>
                <Label styleClass="admin-breadcrumb-text" text="Trang chủ"/>
                <Label styleClass="admin-breadcrumb-sep" text="/"/>
                <Label styleClass="admin-breadcrumb-active" text="Người bán"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button styleClass="button-ghost button-row" mnemonicParsing="false"
                        onAction="#handleRefresh" text="Làm mới"/>
            </HBox>

            <!-- Main scrollable content -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="admin-scroll">
                <VBox spacing="24">
                    <padding><Insets top="8" right="32" bottom="32" left="32"/></padding>

                    <!-- ── WELCOME HERO PANEL ── -->
                    <VBox spacing="4" styleClass="welcome-header">
                        <Label styleClass="welcome-title" text="Trang người bán"/>
                        <Label fx:id="welcomeLabel" styleClass="welcome-subtitle" wrapText="true"/>
                        <Label fx:id="actionMessageLabel" styleClass="welcome-subtitle" wrapText="true"/>
                    </VBox>

                    <!-- ── SELLER STAT CARDS ── -->
                    <HBox spacing="16" maxWidth="Infinity">
                        <VBox styleClass="admin-stat-card" spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label styleClass="stat-card-label" text="Tổng phiên"/>
                            <Label fx:id="statSellerTotal" styleClass="stat-card-value" text="0"/>
                            <Label styleClass="trend-flat" text="Tự động cập nhật"/>
                        </VBox>
                        <VBox styleClass="admin-stat-card" spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label styleClass="stat-card-label" text="Đang diễn ra"/>
                            <Label fx:id="statSellerRunning" styleClass="stat-card-value-success" text="0"/>
                            <Label styleClass="trend-up" text="Theo trạng thái RUNNING"/>
                        </VBox>
                        <VBox styleClass="admin-stat-card" spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label styleClass="stat-card-label" text="Đã kết thúc"/>
                            <Label fx:id="statSellerFinished" styleClass="stat-card-value-warning" text="0"/>
                            <Label styleClass="trend-flat" text="FINISHED / PAID"/>
                        </VBox>
                        <VBox styleClass="admin-stat-card" spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label styleClass="stat-card-label" text="Tổng doanh thu"/>
                            <Label fx:id="statSellerRevenue" styleClass="stat-card-value-accent" text="\$0"/>
                            <Label styleClass="trend-flat" text="Phiên đã thanh toán"/>
                        </VBox>
                        <!-- Static 5th stat card (no fx:id needed) -->
                        <VBox styleClass="admin-stat-card" spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label styleClass="stat-card-label" text="Chờ duyệt"/>
                            <Label styleClass="stat-card-value-warning" text="—"/>
                            <Label styleClass="trend-flat" text="Chờ admin xác nhận"/>
                        </VBox>
                    </HBox>

                    <!-- ═══════════════════════════
                         CREATE AUCTION CARD
                         ═══════════════════════════ -->
                    <VBox styleClass="admin-card" spacing="0">
                        <!-- Card header with integrated stepper -->
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-card-header">
                            <StackPane styleClass="icon-tile-colored">
                                <Label styleClass="icon-tile-text" text="＋"/>
                            </StackPane>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label styleClass="admin-card-title" text="Tạo phiên đấu giá mới"/>
                                <Label styleClass="muted-label"
                                       text="Vui lòng điền thông tin và đăng tải ảnh để khởi tạo phiên đấu giá"/>
                            </VBox>
                            <!-- Stepper inside header -->
                            <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="seller-stepper">
                                <Label styleClass="step-pill-active" text="1. Thông tin"/>
                                <Label styleClass="step-pill" text="2. Cấu hình giá"/>
                                <Label styleClass="step-pill" text="3. Ảnh"/>
                            </HBox>
                        </HBox>

                        <!-- Form body -->
                        <VBox spacing="18">
                            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                            <!-- Row 1: Type + Name -->
                            <HBox spacing="14">
                                <VBox spacing="6" prefWidth="200">
                                    <Label styleClass="login-field-label" text="Loại sản phẩm"/>
                                    <ComboBox fx:id="itemTypeComboBox" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label styleClass="login-field-label" text="Tên vật phẩm"/>
                                    <TextField fx:id="itemNameField" promptText="Ví dụ: iPhone 15 Pro Max"/>
                                </VBox>
                            </HBox>

                            <!-- Row 2: Description (taller) + Starting price -->
                            <HBox spacing="14">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label styleClass="login-field-label" text="Mô tả sản phẩm"/>
                                    <TextField fx:id="itemDescriptionField"
                                               promptText="Mô tả chi tiết sản phẩm..."
                                               prefHeight="80"/>
                                </VBox>
                                <VBox spacing="10" prefWidth="200">
                                    <VBox spacing="4">
                                        <Label styleClass="login-field-label" text="Giá khởi điểm ($)"/>
                                        <TextField fx:id="startingPriceField" promptText="100"/>
                                    </VBox>
                                    <VBox spacing="4">
                                        <Label styleClass="login-field-label" text="Thời gian (phút)"/>
                                        <TextField fx:id="durationField" promptText="5" text="5"/>
                                    </VBox>
                                </VBox>
                            </HBox>

                            <!-- Upload zone with more vertical padding -->
                            <VBox fx:id="dropZone" spacing="14" HBox.hgrow="ALWAYS"
                                  styleClass="upload-zone upload-zone-gallery">
                                <padding><Insets top="24" right="22" bottom="24" left="22"/></padding>
                                <HBox spacing="14" alignment="CENTER_LEFT">
                                    <StackPane styleClass="upload-icon-tile">
                                        <Label styleClass="icon-tile-text" text="Ảnh"/>
                                    </StackPane>
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label styleClass="admin-card-title" text="Ảnh sản phẩm"/>
                                        <Label fx:id="selectedImageLabel" styleClass="muted-label"
                                               text="Chọn nhiều ảnh hoặc kéo thả vào đây. Ảnh đầu tiên sẽ làm ảnh bìa."/>
                                    </VBox>
                                    <Button styleClass="button-ghost button-row" mnemonicParsing="false"
                                            onAction="#handleChooseImage" text="Chọn nhiều ảnh"/>
                                    <Button fx:id="clearImageBtn" styleClass="button-icon" mnemonicParsing="false"
                                            onAction="#handleClearImage" text="Xóa" disable="true"/>
                                </HBox>
                                <FlowPane fx:id="imagePreviewContainer" hgap="8" vgap="8"
                                          styleClass="image-preview-strip"/>
                            </VBox>

                            <!-- Submit button with icon text -->
                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button styleClass="button-primary" mnemonicParsing="false" prefHeight="46"
                                        onAction="#handleCreateAuction" text="▸ Tạo phiên đấu giá"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Visual separator between cards -->
                    <Region prefHeight="4"/>

                    <!-- ═══════════════════════════
                         EXISTING AUCTIONS CARD
                         ═══════════════════════════ -->
                    <VBox styleClass="admin-card" spacing="0" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-card-header">
                            <StackPane styleClass="icon-tile-colored">
                                <Label styleClass="icon-tile-text" text="📦"/>
                            </StackPane>
                            <Label styleClass="admin-card-title" text="Phiên đấu giá của bạn"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label styleClass="muted-label" text="Kéo xuống để xem thêm"/>
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                    prefHeight="420.0" styleClass="admin-scroll-transparent" VBox.vgrow="ALWAYS">
                            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                            <FlowPane fx:id="sellerAuctionGrid" hgap="16" vgap="16" styleClass="auction-grid">
                                <!-- Dynamic cards go here -->
                            </FlowPane>
                        </ScrollPane>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- Footer -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-footer">
                <padding><Insets top="14" right="28" bottom="14" left="28"/></padding>
                <Label styleClass="admin-footer-text" text="© 2026 Auctra"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="admin-footer-text" text="Điều khoản · Trợ giúp · Liên hệ"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
</StackPane>
