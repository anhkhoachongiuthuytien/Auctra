<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.AuthController"
           styleClass="auth-root">
    <HBox>
        <VBox styleClass="auth-brand-panel" alignment="CENTER_LEFT" spacing="28"
              HBox.hgrow="ALWAYS" prefWidth="620" minWidth="420">
            <Label styleClass="auth-brand-kicker" text="DEMO AUCTION APP"/>
            <VBox spacing="8">
                <Label styleClass="auth-brand-title" text="Auctra"/>
                <Label styleClass="auth-brand-copy" maxWidth="520" wrapText="true"
                       text="Ứng dụng đấu giá JavaFX cho ba vai trò: admin quản trị hệ thống, seller tạo phiên và bidder đặt giá realtime."/>
            </VBox>

            <VBox spacing="10" maxWidth="520">
                <Label styleClass="auth-demo-password" text="Tài khoản mẫu - mật khẩu: demo12345"/>
                <HBox styleClass="auth-demo-card" spacing="12" alignment="CENTER_LEFT">
                    <Label styleClass="auth-demo-role" text="Admin"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="auth-demo-email" text="admin@auction.local"/>
                </HBox>
                <HBox styleClass="auth-demo-card" spacing="12" alignment="CENTER_LEFT">
                    <Label styleClass="auth-demo-role" text="Seller"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="auth-demo-email" text="seller@auction.local"/>
                </HBox>
                <HBox styleClass="auth-demo-card" spacing="12" alignment="CENTER_LEFT">
                    <Label styleClass="auth-demo-role" text="Bidder"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="auth-demo-email" text="bidder@auction.local"/>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Extra vertical margin above chips via padding -->
            <VBox>
                <padding><Insets top="16"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label styleClass="chip-warning" text="Realtime"/>
                    <Label styleClass="chip-success" text="An toàn"/>
                    <Label styleClass="chip-info" text="Minh bạch"/>
                </HBox>
            </VBox>
        </VBox>

        <VBox styleClass="auth-form-panel" alignment="CENTER" HBox.hgrow="ALWAYS" minWidth="420">
            <VBox styleClass="google-auth-card" alignment="TOP_LEFT" spacing="16" maxWidth="400">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="brand-mark-large">
                        <Label styleClass="brand-mark-large-text" text="A"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label styleClass="brand-word-large" text="Auctra"/>
                        <Label styleClass="brand-tag" text="Đăng nhập tài khoản"/>
                    </VBox>
                </HBox>

                <VBox spacing="4">
                    <Label styleClass="auth-title" text="Chào mừng trở lại"/>
                    <Label styleClass="auth-subtitle" text="Dùng tài khoản demo hoặc tài khoản đã đăng ký."/>
                </VBox>

                <VBox styleClass="field-shell">
                    <Label styleClass="field-label" text="Email"/>
                    <TextField fx:id="emailField" promptText="admin@auction.local" styleClass="google-input" maxWidth="Infinity"/>
                </VBox>

                <VBox styleClass="field-shell">
                    <Label styleClass="field-label" text="Mật khẩu"/>
                    <PasswordField fx:id="passwordField" promptText="demo12345" styleClass="google-input" maxWidth="Infinity"/>
                </VBox>

                <HBox alignment="CENTER_LEFT">
                    <CheckBox text="Ghi nhớ đăng nhập"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink text="Quên mật khẩu?" onAction="#goToForgotPassword"/>
                </HBox>

                <!-- Subtle divider between remember-me and submit -->
                <Separator styleClass="auth-divider"/>

                <Label fx:id="messageLabel" maxWidth="Infinity" styleClass="info-label" wrapText="true"/>

                <Button styleClass="google-btn-primary button-full" mnemonicParsing="false"
                        onAction="#handleLogin" text="Tiếp theo" maxWidth="Infinity"/>

                <HBox alignment="CENTER" spacing="4">
                    <Label styleClass="muted-label" text="Chưa có tài khoản?"/>
                    <Hyperlink text="Tạo tài khoản" onAction="#goToRegister"/>
                </HBox>
            </VBox>

            <HBox alignment="CENTER" spacing="20">
                <padding><Insets top="28"/></padding>
                <Label styleClass="auth-footer-link" text="JavaFX"/>
                <Label styleClass="auth-footer-link" text="SQLite"/>
                <Label styleClass="auth-footer-link" text="Realtime"/>
            </HBox>
        </VBox>
    </HBox>
</StackPane>
