<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.*?>
<?import com.auction.ui.ResponsiveColumns?>
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:id="rootPane" fx:controller="com.auction.controller.AdminController">
    <BorderPane styleClass="admin-root">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-top-nav">
                <StackPane styleClass="brand-mark">
                    <Label text="A" styleClass="brand-mark-text"/>
                </StackPane>
                <Label text="Auctra" styleClass="brand-word" wrapText="true" minWidth="0"/>
                <Label text="Quản trị" styleClass="brand-tag" wrapText="true" minWidth="0"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Sáng / tối" onAction="#handleToggleTheme" styleClass="button-ghost" mnemonicParsing="false"/>
                <Button text="Tài khoản" onAction="#goToProfile" styleClass="button-ghost" mnemonicParsing="false" accessibleText="Mở tài khoản"/>
                <StackPane styleClass="admin-user-avatar">
                    <Label fx:id="userInitialsLabel" text="U" styleClass="admin-user-avatar-text" wrapText="true" minWidth="0"/>
                </StackPane>
            </HBox>
        </top>
        <left>
            <VBox spacing="6" prefWidth="192" minWidth="176" styleClass="admin-sidebar">
                <Button fx:id="navDashboard" text="Tổng quan" onAction="#handleShowDashboard" styleClass="nav-link-active" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="navUsers" text="Người dùng" onAction="#handleShowUsers" styleClass="nav-link" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="navAuctions" text="Phiên đấu giá" onAction="#handleShowAuctions" styleClass="nav-link" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button text="Tài khoản" onAction="#goToProfile" styleClass="nav-link" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Region VBox.vgrow="ALWAYS"/>
                <VBox spacing="4" styleClass="sidebar-user-card">
                    <Label fx:id="sidebarUserNameLabel" text="" styleClass="sidebar-user-name" wrapText="true" minWidth="0"/>
                    <Label fx:id="sidebarUserMetaLabel" text="" styleClass="sidebar-user-meta" wrapText="true" minWidth="0"/>
                </VBox>
                <Button text="Đăng xuất" onAction="#handleBackToLogin" styleClass="nav-link" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            </VBox>
        </left>
        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
                <VBox spacing="24" minWidth="0" styleClass="page-content">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="6" minWidth="0">
                            <Label fx:id="welcomeLabel" text="Tổng quan" styleClass="screen-title" wrapText="true" minWidth="0"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Làm mới" onAction="#handleRefresh" styleClass="button-ghost" mnemonicParsing="false"/>
                    </HBox>
                    <Label fx:id="actionMessageLabel" text="" styleClass="info-label" wrapText="true" minWidth="0"/>
                    <VBox fx:id="dashboardSection" spacing="24" minWidth="0">
                        <FlowPane hgap="28" vgap="16" styleClass="stat-strip">
                            <VBox spacing="6" prefWidth="165">
                                <Label text="Người dùng" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <Label fx:id="statTotalUsers" text="0" styleClass="stat-value" wrapText="true" minWidth="0"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="165">
                                <Label text="Đang diễn ra" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <Label fx:id="statRunningAuctions" text="0" styleClass="stat-value" wrapText="true" minWidth="0"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="165">
                                <Label text="Đã thanh toán" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <Label fx:id="statPaidAuctions" text="0" styleClass="stat-value" wrapText="true" minWidth="0"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="165">
                                <Label text="Doanh thu ($)" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <Label fx:id="statRevenue" text="0" styleClass="stat-value" wrapText="true" minWidth="0"/>
                            </VBox>
                        </FlowPane>
                        <Label text="Trạng thái các phiên" styleClass="section-title" wrapText="true" minWidth="0"/>
                        <Label text="Số lượng phiên theo trạng thái trong dữ liệu hiện tại." styleClass="muted-label" wrapText="true" minWidth="0"/>
                        <BarChart fx:id="opsChart" legendVisible="false" animated="false" prefHeight="280" minWidth="0">
                            <xAxis>
                                <CategoryAxis label="Trạng thái"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Số phiên" tickUnit="1" minorTickVisible="false"/>
                            </yAxis>
                        </BarChart>
                        <FlowPane hgap="10" vgap="10">
                            <Button text="Quản lý người dùng" onAction="#handleShowUsers" styleClass="button-ghost" mnemonicParsing="false"/>
                            <Button text="Quản lý phiên đấu giá" onAction="#handleShowAuctions" styleClass="button-ghost" mnemonicParsing="false"/>
                        </FlowPane>
                    </VBox>
                    <VBox fx:id="usersSection" spacing="18" visible="false" managed="false" minWidth="0">
                        <Label text="Người dùng" styleClass="section-title" wrapText="true" minWidth="0"/>
                        <VBox spacing="6" minWidth="0">
                            <Label text="Tìm người dùng" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${userSearchField}"/>
                            <TextField fx:id="userSearchField" promptText="Tên hoặc email" maxWidth="Infinity" minWidth="0"/>
                        </VBox>
                        <FlowPane fx:id="userGrid" hgap="20" vgap="20" minWidth="0"/>
                    </VBox>
                    <VBox fx:id="auctionsSection" spacing="18" visible="false" managed="false" minWidth="0">
                        <Label text="Phiên đấu giá" styleClass="section-title" wrapText="true" minWidth="0"/>
                        <VBox spacing="6" minWidth="0">
                            <Label text="Tìm phiên đấu giá" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${auctionSearchField}"/>
                            <TextField fx:id="auctionSearchField" promptText="Tên vật phẩm hoặc người bán" maxWidth="Infinity" minWidth="0"/>
                        </VBox>
                        <FlowPane fx:id="auctionGrid" hgap="20" vgap="20" minWidth="0"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>
