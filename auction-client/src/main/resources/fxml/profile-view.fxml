<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.*?>
<?import com.auction.ui.ResponsiveColumns?>
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:id="rootPane" fx:controller="com.auction.controller.ProfileController">
    <BorderPane styleClass="admin-root">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-top-nav">
                <StackPane styleClass="brand-mark">
                    <Label text="A" styleClass="brand-mark-text"/>
                </StackPane>
                <Label text="Auctra" styleClass="brand-word" wrapText="true" minWidth="0"/>
                <Label text="Tài khoản" styleClass="brand-tag" wrapText="true" minWidth="0"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Sáng / tối" onAction="#handleToggleTheme" styleClass="button-ghost" mnemonicParsing="false"/>
                <Button text="Tài khoản" onAction="#goToProfile" styleClass="button-ghost" mnemonicParsing="false" accessibleText="Mở tài khoản"/>
                <StackPane styleClass="admin-user-avatar">
                    <Label fx:id="userInitialsLabel" text="U" styleClass="admin-user-avatar-text" wrapText="true" minWidth="0"/>
                </StackPane>
            </HBox>
        </top>
        <left>
            <VBox spacing="6" prefWidth="192" minWidth="176" styleClass="admin-sidebar">
                <Button fx:id="navAuctions" text="Trang chủ" onAction="#goToAuctions" styleClass="nav-link" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Button fx:id="navProfile" text="Tài khoản" onAction="#goToProfile" styleClass="nav-link-active" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
                <Region VBox.vgrow="ALWAYS"/>
                <VBox spacing="4" styleClass="sidebar-user-card">
                    <Label fx:id="sidebarUserNameLabel" text="" styleClass="sidebar-user-name" wrapText="true" minWidth="0"/>
                    <Label fx:id="sidebarUserMetaLabel" text="" styleClass="sidebar-user-meta" wrapText="true" minWidth="0"/>
                </VBox>
                <Button text="Đăng xuất" onAction="#handleLogout" styleClass="nav-link" mnemonicParsing="false" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            </VBox>
        </left>
        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
                <VBox spacing="24" minWidth="0" styleClass="page-content">
                    <VBox spacing="6" minWidth="0">
                        <Label text="Tài khoản" styleClass="screen-title" wrapText="true" minWidth="0"/>
                        <Label text="Cập nhật thông tin dùng khi tham gia đấu giá." styleClass="muted-label" wrapText="true" minWidth="0"/>
                    </VBox>
                    <ResponsiveColumns breakpoint="620" gap="24">
                        <VBox spacing="16" minWidth="0">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <StackPane styleClass="profile-avatar-large">
                                    <Label fx:id="userAvatarBigLabel" text="U" styleClass="profile-avatar-text" wrapText="true" minWidth="0"/>
                                </StackPane>
                                <VBox spacing="6" minWidth="0">
                                    <Label fx:id="userNameLabel" text="" styleClass="section-title" wrapText="true" minWidth="0"/>
                                    <Label fx:id="userRoleLabel" text="" styleClass="chip-info" wrapText="true" minWidth="0"/>
                                    <Label fx:id="userEmailLabel" text="" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                </VBox>
                            </HBox>
                            <FlowPane hgap="10" vgap="10">
                                <Button text="Đổi ảnh đại diện" onAction="#handleChangeAvatar" styleClass="button-ghost" mnemonicParsing="false"/>
                                <Button text="Chỉnh sửa hồ sơ" onAction="#handleEditProfileV2" styleClass="button-primary" mnemonicParsing="false"/>
                            </FlowPane>
                            <VBox spacing="8" styleClass="profile-status">
                                <Label fx:id="profileRoleValue" text="" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <Label fx:id="profileEmailStatusValue" text="" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                <Label fx:id="profileAvatarStatusValue" text="" styleClass="muted-label" wrapText="true" minWidth="0"/>
                            </VBox>
                        </VBox>
                        <VBox spacing="16" minWidth="0">
                            <Label text="Thông tin tài khoản" styleClass="section-title" wrapText="true" minWidth="0"/>
                            <VBox fx:id="metaRowsContainer" spacing="0" minWidth="0">
                                <VBox spacing="5" styleClass="meta-row">
                                    <Label text="Mã người dùng" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                    <Label fx:id="userIdLabel" text="" styleClass="meta-value" wrapText="true" minWidth="0"/>
                                </VBox>
                                <VBox spacing="5" styleClass="meta-row">
                                    <Label text="Email đăng nhập" styleClass="muted-label" wrapText="true" minWidth="0"/>
                                    <Label fx:id="emailValueLabel" text="" styleClass="meta-value" wrapText="true" minWidth="0"/>
                                </VBox>
                            </VBox>
                        </VBox>
                    </ResponsiveColumns>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>
