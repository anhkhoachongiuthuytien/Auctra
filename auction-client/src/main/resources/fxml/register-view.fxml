<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.RegisterController"
           styleClass="auth-root">
    <HBox>
        <VBox styleClass="auth-brand-panel" alignment="CENTER_LEFT" spacing="28"
              HBox.hgrow="ALWAYS" prefWidth="620" minWidth="420">
            <Label styleClass="auth-brand-kicker" text="START BIDDING"/>
            <VBox spacing="8">
                <Label styleClass="auth-brand-title" text="Auctra"/>
                <Label styleClass="auth-brand-copy" maxWidth="520" wrapText="true"
                       text="Tạo tài khoản để bán vật phẩm, tham gia phiên đấu giá và theo dõi mọi thay đổi giá theo thời gian thực."/>
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label styleClass="chip-warning" text="Miễn phí"/>
                <Label styleClass="chip-success" text="Bảo mật"/>
                <Label styleClass="chip-info" text="Nhanh chóng"/>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="10">
                <Label styleClass="auth-brand-copy" text="Quy trình đăng ký"/>
                <Label styleClass="auth-subtitle" text="3 bước đơn giản"/>
                <HBox spacing="8">
                    <Label styleClass="step-pill-active" text="1. Hồ sơ"/>
                    <Label styleClass="step-pill" text="2. Vai trò"/>
                    <Label styleClass="step-pill" text="3. Sẵn sàng"/>
                </HBox>
            </VBox>
        </VBox>

        <VBox styleClass="auth-form-panel" alignment="CENTER" HBox.hgrow="ALWAYS" minWidth="420">
            <VBox styleClass="google-auth-card" alignment="TOP_LEFT" spacing="16" maxWidth="440">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="brand-mark-large">
                        <Label styleClass="brand-mark-large-text" text="A"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label styleClass="brand-word-large" text="Auctra"/>
                        <Label styleClass="brand-tag" text="Tạo tài khoản mới"/>
                    </VBox>
                </HBox>

                <VBox spacing="4">
                    <Label styleClass="auth-title" text="Bắt đầu với Auctra"/>
                    <Label styleClass="auth-subtitle" text="Nhập thông tin để mở quyền truy cập."/>
                </VBox>

                <VBox styleClass="field-shell">
                    <Label styleClass="field-label" text="Tên hiển thị"/>
                    <TextField fx:id="registerUsernameField" promptText="Ví dụ: Nguyen An" styleClass="google-input" maxWidth="Infinity"/>
                </VBox>

                <VBox styleClass="field-shell">
                    <Label styleClass="field-label" text="Email"/>
                    <TextField fx:id="registerEmailField" promptText="name@example.com" styleClass="google-input" maxWidth="Infinity"/>
                </VBox>

                <HBox spacing="10">
                    <VBox styleClass="field-shell" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Mật khẩu"/>
                        <PasswordField fx:id="registerPasswordField" promptText="Tối thiểu 8 ký tự" styleClass="google-input" maxWidth="Infinity"/>
                    </VBox>
                    <VBox styleClass="field-shell" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Xác nhận"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại" styleClass="google-input" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Password strength with label wrapper for better alignment -->
                <VBox styleClass="field-shell" spacing="5">
                    <Label styleClass="field-label" text="Độ mạnh mật khẩu"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <ProgressBar fx:id="passwordStrengthBar" progress="0.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label fx:id="passwordStrengthLabel" styleClass="muted-label" text="Chưa nhập" minWidth="70"/>
                    </HBox>
                </VBox>

                <VBox styleClass="field-shell">
                    <Label styleClass="field-label" text="Loại tài khoản"/>
                    <ComboBox fx:id="roleComboBox" maxWidth="Infinity" promptText="Chọn loại tài khoản" styleClass="google-input"/>
                </VBox>

                <Label fx:id="messageLabel" maxWidth="Infinity" styleClass="info-label" wrapText="true"/>

                <Button styleClass="google-btn-primary button-full" mnemonicParsing="false"
                        onAction="#handleRegister" text="Tạo tài khoản" maxWidth="Infinity"/>

                <HBox alignment="CENTER" spacing="4">
                    <Label styleClass="muted-label" text="Đã có tài khoản?"/>
                    <Hyperlink text="Đăng nhập" onAction="#goToLogin"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
