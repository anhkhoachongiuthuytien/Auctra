<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.*?>
<?import com.auction.ui.ResponsiveColumns?>
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:id="rootPane" styleClass="auth-root" fx:controller="com.auction.controller.RegisterController">
    <HBox minWidth="0">
        <VBox styleClass="auth-brand-panel" spacing="24" prefWidth="430" minWidth="340" maxWidth="430">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane styleClass="brand-mark">
                    <Label text="A" styleClass="brand-mark-text"/>
                </StackPane>
                <Label text="Auctra" styleClass="auth-brand-title" wrapText="true" minWidth="0"/>
            </HBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Mỗi lượt giá, một lựa chọn." styleClass="auth-brand-heading" wrapText="true" minWidth="0"/>
            <Label text="Khám phá vật phẩm, theo dõi giá và chủ động chọn giới hạn của bạn." styleClass="auth-brand-copy" wrapText="true" minWidth="0"/>
            <Separator/>
            <Label text="Đặt giá trực tiếp hoặc dùng tự động đặt giá. Lịch sử của phiên giúp bạn theo dõi từng thay đổi." styleClass="auth-brand-copy" wrapText="true" minWidth="0"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" HBox.hgrow="ALWAYS" minWidth="0" styleClass="auth-scroll">
            <VBox alignment="TOP_CENTER" spacing="24" minWidth="0" styleClass="auth-form-panel">
                <VBox spacing="18" minWidth="0" maxWidth="440" styleClass="auth-form">
                    <VBox spacing="6" minWidth="0">
                        <Label text="Tạo tài khoản" styleClass="screen-title" wrapText="true" minWidth="0"/>
                        <Label text="Chọn vai trò phù hợp với cách bạn tham gia." styleClass="muted-label" wrapText="true" minWidth="0"/>
                    </VBox>
                    <VBox spacing="6" minWidth="0">
                        <Label text="Tên hiển thị" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${registerUsernameField}"/>
                        <TextField fx:id="registerUsernameField" promptText="Ví dụ: Nguyễn An" maxWidth="Infinity" minWidth="0"/>
                    </VBox>
                    <VBox spacing="6" minWidth="0">
                        <Label text="Email" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${registerEmailField}"/>
                        <TextField fx:id="registerEmailField" promptText="name@example.com" maxWidth="Infinity" minWidth="0"/>
                    </VBox>
                    <VBox spacing="6" minWidth="0">
                        <Label text="Mật khẩu" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${registerPasswordField}"/>
                        <PasswordField fx:id="registerPasswordField" promptText="Tối thiểu 8 ký tự" maxWidth="Infinity" minWidth="0"/>
                    </VBox>
                    <VBox spacing="6" minWidth="0">
                        <Label text="Nhập lại mật khẩu" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${confirmPasswordField}"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận mật khẩu" maxWidth="Infinity" minWidth="0"/>
                    </VBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <ProgressBar fx:id="passwordStrengthBar" progress="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="passwordStrengthLabel" text="Chưa nhập" styleClass="muted-label" wrapText="true" minWidth="0"/>
                    </HBox>
                    <VBox spacing="6" minWidth="0">
                        <Label text="Bạn muốn tham gia với vai trò nào?" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${roleComboBox}"/>
                        <ComboBox fx:id="roleComboBox" promptText="Chọn vai trò" maxWidth="Infinity" minWidth="0"/>
                    </VBox>
                    <Label text="Người mua đặt giá; người bán tạo và quản lý phiên." styleClass="muted-label" wrapText="true" minWidth="0"/>
                    <Label fx:id="messageLabel" text="" styleClass="info-label" wrapText="true" minWidth="0"/>
                    <Button text="Tạo tài khoản" onAction="#handleRegister" styleClass="button-primary" mnemonicParsing="false" defaultButton="true" maxWidth="Infinity"/>
                    <HBox alignment="CENTER" spacing="6">
                        <Label text="Đã có tài khoản?"/>
                        <Hyperlink text="Đăng nhập" onAction="#goToLogin"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>
</StackPane>
