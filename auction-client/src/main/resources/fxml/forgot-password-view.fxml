<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.ForgotPasswordController"
           style="-fx-background-color: #FFFFFF;">
    <HBox>

        <!-- LEFT — Google branding -->
        <VBox styleClass="google-brand-panel" alignment="CENTER" spacing="24"
              HBox.hgrow="SOMETIMES" prefWidth="480.0" minWidth="0">
            <padding><Insets top="60" right="48" bottom="60" left="48"/></padding>
            <HBox alignment="CENTER" spacing="16">
                <Circle radius="12" style="-fx-fill: #4285F4;"/>
                <Circle radius="8" style="-fx-fill: #EA4335;"/>
                <Circle radius="10" style="-fx-fill: #FBBC05;"/>
                <Circle radius="14" style="-fx-fill: #34A853;"/>
            </HBox>
            <HBox alignment="CENTER" spacing="0">
                <Label style="-fx-text-fill: #4285F4; -fx-font-size: 64; -fx-font-weight: bold;" text="A"/>
                <Label style="-fx-text-fill: #EA4335; -fx-font-size: 64; -fx-font-weight: bold;" text="u"/>
                <Label style="-fx-text-fill: #FBBC05; -fx-font-size: 64; -fx-font-weight: bold;" text="c"/>
                <Label style="-fx-text-fill: #4285F4; -fx-font-size: 64; -fx-font-weight: bold;" text="t"/>
                <Label style="-fx-text-fill: #34A853; -fx-font-size: 64; -fx-font-weight: bold;" text="r"/>
                <Label style="-fx-text-fill: #EA4335; -fx-font-size: 64; -fx-font-weight: bold;" text="a"/>
            </HBox>
            <Label style="-fx-text-fill: #5F6368; -fx-font-size: 15;" text="Khôi phục tài khoản"/>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="12">
                <Circle radius="6" style="-fx-fill: #34A853; -fx-opacity: 0.4;"/>
                <Circle radius="4" style="-fx-fill: #FBBC05; -fx-opacity: 0.4;"/>
                <Circle radius="8" style="-fx-fill: #4285F4; -fx-opacity: 0.4;"/>
                <Circle radius="5" style="-fx-fill: #EA4335; -fx-opacity: 0.4;"/>
            </HBox>
        </VBox>

        <!-- RIGHT — Reset form -->
        <VBox alignment="CENTER" style="-fx-background-color: #FFFFFF;"
              HBox.hgrow="ALWAYS" minWidth="380">

            <VBox styleClass="google-auth-card" alignment="TOP_CENTER" spacing="4" maxWidth="400">
                <HBox alignment="CENTER" spacing="0" style="-fx-padding: 0 0 6 0;">
                    <Label style="-fx-text-fill: #4285F4; -fx-font-size: 32; -fx-font-weight: bold;" text="A"/>
                    <Label style="-fx-text-fill: #EA4335; -fx-font-size: 32; -fx-font-weight: bold;" text="u"/>
                    <Label style="-fx-text-fill: #FBBC05; -fx-font-size: 32; -fx-font-weight: bold;" text="c"/>
                    <Label style="-fx-text-fill: #4285F4; -fx-font-size: 32; -fx-font-weight: bold;" text="t"/>
                    <Label style="-fx-text-fill: #34A853; -fx-font-size: 32; -fx-font-weight: bold;" text="r"/>
                    <Label style="-fx-text-fill: #EA4335; -fx-font-size: 32; -fx-font-weight: bold;" text="a"/>
                </HBox>
                <Label style="-fx-font-size: 20; -fx-text-fill: #202124;" text="Khôi phục tài khoản"/>
                <Label styleClass="muted-label" wrapText="true" maxWidth="340" style="-fx-text-alignment: center;"
                       text="Nhập email và tên đăng nhập để xác thực"/>

                <Region prefHeight="16"/>

                <TextField fx:id="emailField" promptText="Email" styleClass="google-input" maxWidth="Infinity"/>
                <Region prefHeight="6"/>
                <TextField fx:id="usernameField" promptText="Tên đăng nhập" styleClass="google-input" maxWidth="Infinity"/>
                <Region prefHeight="6"/>
                <HBox spacing="10">
                    <PasswordField fx:id="newPasswordField" promptText="Mật khẩu mới" styleClass="google-input" HBox.hgrow="ALWAYS"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận" styleClass="google-input" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Region prefHeight="12"/>

                <Label fx:id="messageLabel" maxWidth="Infinity" styleClass="info-label" alignment="CENTER" wrapText="true" style="-fx-text-alignment: center;"/>

                <HBox alignment="CENTER_LEFT">
                    <Hyperlink text="Quay lại đăng nhập" onAction="#goToLogin" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button styleClass="google-btn-primary" mnemonicParsing="false" onAction="#handleReset" text="Tiếp theo"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
