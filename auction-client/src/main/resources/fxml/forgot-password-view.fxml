<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.*?>
<?import com.auction.ui.ResponsiveColumns?>
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:id="rootPane" styleClass="auth-root" fx:controller="com.auction.controller.ForgotPasswordController">
    <HBox minWidth="0">
        <VBox styleClass="auth-brand-panel" spacing="24" prefWidth="430" minWidth="340" maxWidth="430">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane styleClass="brand-mark">
                    <Label text="A" styleClass="brand-mark-text"/>
                </StackPane>
                <Label text="Auctra" styleClass="auth-brand-title" wrapText="true" minWidth="0"/>
            </HBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Mỗi lượt giá, một lựa chọn." styleClass="auth-brand-heading" wrapText="true" minWidth="0"/>
            <Label text="Khám phá vật phẩm, theo dõi giá và chủ động chọn giới hạn của bạn." styleClass="auth-brand-copy" wrapText="true" minWidth="0"/>
            <Separator/>
            <Label text="Đặt giá trực tiếp hoặc dùng tự động đặt giá. Lịch sử của phiên giúp bạn theo dõi từng thay đổi." styleClass="auth-brand-copy" wrapText="true" minWidth="0"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" HBox.hgrow="ALWAYS" minWidth="0" styleClass="auth-scroll">
            <VBox alignment="TOP_CENTER" spacing="24" minWidth="0" styleClass="auth-form-panel">
                <VBox spacing="18" minWidth="0" maxWidth="440" styleClass="auth-form">
                    <VBox spacing="6" minWidth="0">
                        <Label text="Đặt lại mật khẩu" styleClass="screen-title" wrapText="true" minWidth="0"/>
                        <Label text="Dùng email và mã khôi phục để lấy lại quyền truy cập." styleClass="muted-label" wrapText="true" minWidth="0"/>
                    </VBox>
                    <VBox spacing="6" minWidth="0">
                        <Label text="Email" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${emailField}"/>
                        <TextField fx:id="emailField" promptText="name@example.com" maxWidth="Infinity" minWidth="0"/>
                    </VBox>
                    <VBox spacing="6" minWidth="0">
                        <Label text="Mã khôi phục" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${recoveryCodeField}"/>
                        <TextField fx:id="recoveryCodeField" promptText="Mã bí mật đã lưu khi đăng ký" maxWidth="Infinity" minWidth="0"/>
                    </VBox>
                    <Label text="Mã dùng được một lần. Nếu mất mã, liên hệ người quản lý máy chủ để được cấp lại." styleClass="muted-label" wrapText="true" minWidth="0"/>
                    <VBox spacing="6" minWidth="0">
                        <Label text="Mật khẩu mới" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${newPasswordField}"/>
                        <PasswordField fx:id="newPasswordField" promptText="Tối thiểu 8 ký tự" maxWidth="Infinity" minWidth="0"/>
                    </VBox>
                    <VBox spacing="6" minWidth="0">
                        <Label text="Nhập lại mật khẩu mới" styleClass="field-label" wrapText="true" minWidth="0" labelFor="${confirmPasswordField}"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận mật khẩu" maxWidth="Infinity" minWidth="0"/>
                    </VBox>
                    <Label fx:id="messageLabel" text="" styleClass="info-label" wrapText="true" minWidth="0"/>
                    <Button text="Đặt lại mật khẩu" onAction="#handleReset" styleClass="button-primary" mnemonicParsing="false" defaultButton="true" maxWidth="Infinity"/>
                    <Hyperlink text="Quay lại đăng nhập" onAction="#goToLogin"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>
</StackPane>
