<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.ForgotPasswordController"
           styleClass="auth-root">
    <HBox>
        <VBox styleClass="auth-brand-panel" alignment="CENTER_LEFT" spacing="28"
              HBox.hgrow="ALWAYS" prefWidth="620" minWidth="420">
            <Label styleClass="auth-brand-kicker" text="ACCOUNT RECOVERY"/>
            <VBox spacing="8">
                <Label styleClass="auth-brand-title" text="Auctra"/>
                <Label styleClass="auth-brand-copy" maxWidth="520" wrapText="true"
                       text="Khôi phục quyền truy cập bằng email và tên đăng nhập đã đăng ký trong hệ thống."/>
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label styleClass="chip-warning" text="Xác thực"/>
                <Label styleClass="chip-success" text="Bảo mật"/>
                <Label styleClass="chip-info" text="Nhanh"/>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Numbered step indicator section -->
            <VBox spacing="10">
                <Label styleClass="auth-brand-copy" text="Quy trình khôi phục"/>
                <Label styleClass="auth-subtitle" text="3 bước đơn giản"/>
                <HBox spacing="8">
                    <Label styleClass="step-pill-active" text="1. Xác thực"/>
                    <Label styleClass="step-pill" text="2. Mật khẩu"/>
                    <Label styleClass="step-pill" text="3. Hoàn tất"/>
                </HBox>
            </VBox>
        </VBox>

        <VBox styleClass="auth-form-panel" alignment="CENTER" HBox.hgrow="ALWAYS" minWidth="420">
            <VBox styleClass="google-auth-card" alignment="TOP_LEFT" spacing="16" maxWidth="440">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="brand-mark-large">
                        <Label styleClass="brand-mark-large-text" text="A"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label styleClass="brand-word-large" text="Auctra"/>
                        <Label styleClass="brand-tag" text="Khôi phục tài khoản"/>
                    </VBox>
                </HBox>

                <VBox spacing="4">
                    <Label styleClass="auth-title" text="Đặt lại mật khẩu"/>
                    <Label styleClass="auth-subtitle" wrapText="true"
                           text="Nhập email và tên đăng nhập để xác thực trước khi đặt mật khẩu mới."/>
                </VBox>

                <!-- Section: Identity verification -->
                <VBox spacing="14">
                    <padding><Insets top="4"/></padding>
                    <VBox styleClass="field-shell">
                        <Label styleClass="field-label" text="Email"/>
                        <TextField fx:id="emailField" promptText="name@example.com" styleClass="google-input" maxWidth="Infinity"/>
                    </VBox>

                    <VBox styleClass="field-shell">
                        <Label styleClass="field-label" text="Tên đăng nhập"/>
                        <TextField fx:id="usernameField" promptText="Tên tài khoản" styleClass="google-input" maxWidth="Infinity"/>
                    </VBox>
                </VBox>

                <!-- Divider between sections for visual breathing room -->
                <Separator styleClass="auth-divider"/>

                <!-- Section: New password -->
                <VBox spacing="14">
                    <HBox spacing="10">
                        <VBox styleClass="field-shell" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Mật khẩu mới"/>
                            <PasswordField fx:id="newPasswordField" promptText="Mật khẩu mới" styleClass="google-input" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="field-shell" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Xác nhận"/>
                            <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại" styleClass="google-input" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                </VBox>

                <Label fx:id="messageLabel" maxWidth="Infinity" styleClass="info-label" wrapText="true"/>

                <Button styleClass="google-btn-primary button-full" mnemonicParsing="false"
                        onAction="#handleReset" text="Đặt lại mật khẩu" maxWidth="Infinity"/>

                <HBox alignment="CENTER" spacing="4">
                    <Hyperlink text="Quay lại đăng nhập" onAction="#goToLogin"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
